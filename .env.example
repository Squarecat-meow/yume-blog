# Cloudflare Access
# Zero Trust 대시보드 > Settings > Custom Pages 에서 팀 도메인 확인
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# Access 애플리케이션 개별 발급 값. 계정 단위가 아니라 앱 단위이며,
# 이 값을 검증하지 않으면 같은 팀의 다른 Access 앱 토큰으로도 통과된다.
# /admin 과 /api/admin 을 별도 애플리케이션으로 등록했다면 쉼표로 둘 다 나열한다.
CF_ACCESS_AUD=<AUD 태그>,<두 번째 앱의 AUD 태그>
# 쉼표 구분. 비어 있으면 관리자 접근이 전부 차단된다(fail-closed).
ADMIN_ALLOWED_EMAILS=yozumina@serafuku.moe

# 로컬 개발 전용 우회. NODE_ENV=development 일 때만 동작하므로
# 프로덕션 빌드에서는 켜져 있어도 무시된다.
ADMIN_DEV_BYPASS=true

# Notion
# Notion 인테그레이션 생성 후 발급되는 Internal Integration Secret.
# 포스트 DB를 이 인테그레이션과 공유(Connect)해야 조회가 된다.
NOTION_API_KEY=secret_<발급된 값>
# database_id가 아니라 data_source_id다. 2025-09-03 API부터 분리됐다.
# Notion URL에 보이는 ID를 그대로 쓰면 400/404가 난다 —
# `client.databases.retrieve({ database_id })` 응답의 data_sources[0].id로 조회해서 얻는다.
NOTION_DATA_SOURCE_ID=<data source id>
# 소설 DB. Post와 별도 데이터베이스이므로 data_source_id도 따로 조회해서 넣는다.
NOTION_NOVEL_DATA_SOURCE_ID=<data source id>
